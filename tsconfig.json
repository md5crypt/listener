{
	"include": [
		"src/**/*.ts"
	],
	"compilerOptions": {
		"rootDir": "src",
		"target": "ES2017",
		"module": "ES2022",
		"declaration": true,
		"sourceMap": false,
		"moduleResolution": "bundler",
		"outDir": "dist",
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noImplicitThis": true,
		"alwaysStrict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"preserveSymlinks": true,
		"allowSyntheticDefaultImports": true
	}
}